# ── LLM Provider ──────────────────────────────────────────────────────────────
# Set exactly one of these two keys:
LLM_PROVIDER=gemini          # "gemini" or "openai"
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini     # only used when LLM_PROVIDER=openai
GEMINI_MODEL=gemini-1.5-flash  # only used when LLM_PROVIDER=gemini

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./chronotrace.db

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

