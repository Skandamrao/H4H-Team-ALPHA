# ==================================================
# ChronoGraph AI - Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# --- Google Gemini API ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application Settings ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change_this_to_a_long_random_secret_string

# --- Database ---
DATABASE_URL=sqlite:///./chronograph.db

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/chronograph.log

