# ==================================================
# ChronoGraph AI - Backend Environment Configuration
# ==================================================

# --- Google Gemini API Key ---
# Required for real AI extraction and assistant Q&A.
# If omitted, seeded demo data can still be fully explored.
GEMINI_API_KEY=your_gemini_api_key_here

# --- Application Settings ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=chronograph_super_secret_jwt_key_change_in_production

# --- Database ---
DATABASE_URL=sqlite:///./chronograph.db

# --- File Upload ---
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- CORS ---
ALLOWED_ORIGINS_RAW=http://localhost:5173,http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/chronograph.log

