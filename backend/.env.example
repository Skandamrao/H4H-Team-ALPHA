# ──────────────────────────────────────────────────────────────────────────────
# ChronoGraph AI — Backend Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ─── AI Keys (optional — app works without them via local fallback) ───────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-random-secret

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, good for demos)
DATABASE_URL=sqlite:///./chronograph.db

# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Set to your deployed frontend URL (Vercel)
ALLOWED_ORIGINS_RAW=https://your-app.vercel.app,http://localhost:5173
# OR set CORS_ALLOW_ALL=true for open hackathon demo access
CORS_ALLOW_ALL=false

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/chronograph.log
